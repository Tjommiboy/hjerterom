# Sanity project (sanity.io/manage)
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production

# Token with Editor rights. Server-only: used to save customer requests.
SANITY_API_WRITE_TOKEN=

# Shared secret for the Sanity webhook that refreshes the site on publish
SANITY_REVALIDATE_SECRET=

# Optional: Cloudflare Turnstile spam protection on forms
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
