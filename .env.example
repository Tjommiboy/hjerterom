# Sanity project (sanity.io/manage)
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production

# Token with Editor rights. Server-only: used to save customer requests.
SANITY_API_WRITE_TOKEN=

# Shared secret for the Sanity webhook that refreshes the site on publish
SANITY_REVALIDATE_SECRET=

# Optional: Cloudflare Turnstile spam protection on forms
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Email notifications (resend.com). Each request or message from the site is emailed to the shop.
# Use a "Sending access" key limited to your domain, never a full-access key.
RESEND_API_KEY=
CONTACT_TO_EMAIL=hjerteromibergen@gmail.com
# Leave empty to use Resend's test sender (only delivers to your own Resend account email).
# After verifying your domain in Resend: Hjerterom <post@yourdomain.no>
CONTACT_FROM_EMAIL=
# Used for the "Åpne i Studio" link in emails, e.g. https://hjerterom.no
NEXT_PUBLIC_SITE_URL=http://localhost:3000
